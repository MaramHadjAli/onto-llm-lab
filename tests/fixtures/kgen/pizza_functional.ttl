# Violates FunctionalProperty hasSpiciness (two values).
# Pizza asserts no cardinality restriction, so this is the functional case.
# Objects carry the explicit range type Spiciness. They are not owl:differentFrom.
@prefix pz: <https://raw.githubusercontent.com/owlcs/pizza-ontology/refs/heads/master/pizza.owl#> .
@prefix ex: <http://ollab.local/fixture/pizza/> .

ex:pie a pz:Pizza ;
    pz:hasSpiciness ex:hot, ex:mild .
ex:hot a pz:Spiciness .
ex:mild a pz:Spiciness .
