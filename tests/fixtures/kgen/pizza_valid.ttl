# Valid Pizza individuals: one PizzaBase, no property, no extra type.
# Pizza asserts no minimum cardinality. PizzaBase is only flagged by SHACL
# disjoint shapes when a second, disjoint type is also explicit.
@prefix pz: <https://raw.githubusercontent.com/owlcs/pizza-ontology/refs/heads/master/pizza.owl#> .
@prefix ex: <http://ollab.local/fixture/pizza/> .

ex:base1 a pz:PizzaBase .
ex:base2 a pz:PizzaBase .
