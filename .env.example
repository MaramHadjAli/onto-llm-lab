# Copy to .env and fill in. .env is gitignored. Never commit a real key.

# openai: any OpenAI-compatible chat-completions endpoint.
# ollama: local Ollama server.
# mock: deterministic offline client. This is the default.
OLLAB_LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Cache keys are a hash of provider, endpoint, model, parameters, and prompt.
# The API key is not part of the key and is not written to the cache.
LLM_CACHE_DIR=cache/llm
LLM_USAGE_LOG=results/llm_usage.jsonl
